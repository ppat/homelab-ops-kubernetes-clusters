{
  "models": {
    "providers": {
      "openai": {
        "baseUrl": "http://litellm.ai.svc.cluster.local:4000/v1",
        "apiKey": "${LITELLM_KEY}"
      },
      "litellm": {
        "baseUrl": "http://litellm.ai.svc.cluster.local:4000/v1",
        "apiKey": "${LITELLM_KEY}",
        "api": "openai-completions",
        "timeoutSeconds": 120,
        // LiteLLM serves chat models only through its flat `openrouter/*` wildcard, so their ids
        // keep the `openrouter/` prefix. agents.defaults.model refers to them as
        // `litellm/<id>`. The embedding model is a named LiteLLM alias and has no prefix.
        "models": [
          {
            "id": "openrouter/deepseek/deepseek-v4-flash-0731",
            "name": "DeepSeek v4 Flash (0731)",
            // OpenRouter's DeepSeek-v4 endpoint rejects the `thinking` param
            // OpenClaw sends by default (HTTP 400) -- "openrouter" compat mode
            // omits it instead. See homelab-ops-kubernetes-clusters#740.
            "compat": {
              "thinkingFormat": "openrouter"
            }
          },
          {
            "id": "openrouter/z-ai/glm-5.3-flash",
            "name": "GLM 5.3 Flash"
          },
          {
            "id": "openai/text-embedding-3-small",
            "name": "OpenAI Text Embedding 3 Small"
          }
        ]
      }
    }
  },

  "agents": {
    // The schema requires at least one keyed agent, and every CLI command that validates the
    // config (update status, doctor) warns until one exists. "main" is the agent the gateway
    // already runs implicitly, so declaring it changes no routing.
    "entries": {
      "main": {}
    },
    "defaults": {
      "bootstrapMaxChars": 20000,
      "bootstrapTotalMaxChars": 150000,
      "contextInjection": "always",
      // n8n's Health Diagnose workflow uses these same models (its Settings node). Keep the two equal.
      "model": {
        "primary": "litellm/openrouter/deepseek/deepseek-v4-flash-0731",
        "fallbacks": [
          "litellm/openrouter/z-ai/glm-5.3-flash"
        ]
      },
      // Quiet hours: heartbeats run only outside the operator's quiet hours, 22:00 to 06:00
      // Eastern, so this window is their inverse. The heartbeat is the one sender that does
      // not go through n8n's Notify workflow, where quiet hours are defined; keep the two equal.
      "heartbeat": {
        "activeHours": {
          "start": "06:00",
          "end": "22:00",
          "timezone": "America/New_York"
        }
      }
    }
  },

  "channels": {
    "telegram": {
      "enabled": false,
      "dmPolicy": "pairing",
      "groupPolicy": "allowlist"
    },
    "whatsapp": {
      "enabled": true,
      // Only the numbers below get a response, and everyone else is dropped silently.
      // "pairing" (the default) does NOT gate on allowFrom: it answers any unknown sender
      // with a pairing code.
      //   OWNER_WHATSAPP_NUMBER     - the number this gateway is logged in as. Messaging it
      //                               from itself is self-chat, admitted via selfChatMode.
      //   PERSONAL_WHATSAPP_NUMBER  - the operator's other number.
      "dmPolicy": "allowlist",
      "allowFrom": [
        "${OWNER_WHATSAPP_NUMBER}",
        "${PERSONAL_WHATSAPP_NUMBER}"
      ],
      "selfChatMode": true,
      // Never takes part in groups: group messages are dropped whoever sends them, so the
      // agent only ever talks in a 1:1 chat with one of the two numbers above.
      "groupPolicy": "disabled",
      // Target for outbound messages that name no recipient. Replies to an inbound message
      // always go back to the chat it came from, so the owner number only hears from the
      // agent when the operator writes from that number.
      "defaultTo": "${PERSONAL_WHATSAPP_NUMBER}"
    }
  },

  "mcp": {
    "servers": {
      "context7": {
        "url": "http://litellm.ai.svc.cluster.local:4000/context7_mcp/mcp",
        "transport": "streamable-http",
        "headers": {
          "Authorization": "Bearer ${LITELLM_KEY}"
        }
      },
      "github": {
        "url": "http://litellm.ai.svc.cluster.local:4000/github_mcp/mcp",
        "transport": "streamable-http",
        "headers": {
          "Authorization": "Bearer ${LITELLM_KEY}"
        }
      },
      "grafana": {
        "url": "http://litellm.ai.svc.cluster.local:4000/grafana_mcp/mcp",
        "transport": "streamable-http",
        "headers": {
          "Authorization": "Bearer ${LITELLM_KEY}"
        }
      },
      "home_assistant": {
        "url": "http://litellm.ai.svc.cluster.local:4000/home_assistant_mcp/mcp",
        "transport": "streamable-http",
        "headers": {
          "Authorization": "Bearer ${LITELLM_KEY}"
        }
      },
      "playwright": {
        "url": "http://litellm.ai.svc.cluster.local:4000/playwright_mcp/mcp",
        "transport": "streamable-http",
        "headers": {
          "Authorization": "Bearer ${LITELLM_KEY}"
        }
      }
    }
  },

  // Inbound webhooks. `path` is a base path: endpoints live under it (/hooks/agent,
  // /hooks/wake, /hooks/<mapping>), and a POST to the base path itself returns 404.
  // A webhook with no explicit channel and recipient is not delivered anywhere, so the
  // destination is fixed here rather than by the caller, and callers never carry phone
  // numbers.
  // allowedAgentIds/defaultSessionKey answer `openclaw security audit` findings
  // hooks.allowed_agent_ids_unrestricted (CRITICAL) and hooks.default_session_key_unset (WARN).
  "hooks": {
    "enabled": true,
    "token": "${OPENCLAW_HOOKS_TOKEN}",
    "path": "/hooks",
    "allowedAgentIds": [
      "main"
    ],
    "defaultSessionKey": "hook:ingress",
    "mappings": [
      {
        // POST /hooks/notify {"message": "..."}: n8n's Notify workflow. Each call is one
        // isolated agent turn whose reply goes to the operator's personal number.
        "id": "notify",
        "match": {
          "path": "notify"
        },
        "action": "agent",
        "agentId": "main",
        "messageTemplate": "Relay the notification below to the user word for word, with no commentary and no follow-up questions.\n\n{{message}}",
        "channel": "whatsapp",
        "to": "${PERSONAL_WHATSAPP_NUMBER}"
      }
    ]
  },

  // Jobs are not declared statically here -- `cron.jobs` isn't part of the config schema
  // (jobs live in the gateway's own state store). The daily-digest job is created once,
  // post-deploy, via `openclaw cron add` (same pattern as the WhatsApp QR pairing step).
  "cron": {
    "enabled": true
  },

  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}",
      // Per `openclaw security audit` finding gateway.auth_no_rate_limit (WARN): throttle
      // gateway login/auth attempts to reduce token brute-force risk.
      "rateLimit": {
        "maxAttempts": 10,
        "windowMs": 60000,
        "lockoutMs": 300000
      }
    },
    // bind=lan requires the Control UI's browser origin to be listed explicitly (no
    // wildcards allowed) or the gateway rejects it with "Browser origin not allowed".
    // Localhost entries stay so port-forward/in-cluster access keeps working.
    "controlUi": {
      "allowedOrigins": [
        "${OPENCLAW_CONTROL_UI_ORIGIN}",
        "http://localhost:18789",
        "http://127.0.0.1:18789"
      ]
    }
  },

  // Lockdown: computer/browser tool, elevated/shell/exec, and third-party in-process
  // plugins are all disabled.
  //
  // `deny` is matched on TOOL NAME, not plugin id, so a plugin can be allowlisted while the
  // dangerous tool it registers stays unavailable. Two entries beyond the original lockdown:
  //   code_execution - registered by the xai plugin, which is bundled in the base image but
  //                    deliberately NOT allowlisted, so this is pre-emptive. It runs
  //                    model-authored code in a remote xAI sandbox; keep it denied if xai is
  //                    ever enabled, since allowlisting the plugin alone would expose it.
  //   voice_call     - registered by the voice-call plugin, which is baked into the image but
  //                    NOT allowlisted yet, so this is pre-emptive. That plugin has no outbound
  //                    destination allowlist, so the agent must never hold the dialling tool;
  //                    alerts should be driven from n8n/Alertmanager via the
  //                    `voicecall.initiate` gateway RPC with `to` omitted (falls back to the
  //                    configured `toNumber`). Denying the tool does not block that RPC path.
  "tools": {
    "deny": [
      "browser",
      "code_execution",
      "exec",
      "voice_call"
    ],
    "elevated": {
      "enabled": false
    },
    "web": {
      "search": {
        // Pinned explicitly rather than left to auto-detection. duckduckgo stays allowlisted
        // as a key-free fallback, but key-free providers never win auto-detection, so the
        // provider in use is always whatever is named here. Switch to "searxng" once a
        // SearXNG instance is deployed in-cluster (that plugin is already baked into the
        // image and allowlisted), or "duckduckgo" to drop the third-party dependency.
        "enabled": true,
        "provider": "brave"
      },
      "fetch": {
        "enabled": true
      }
    }
  },

  // plugins.allow is keyed by plugin ID (e.g. "whatsapp"), NOT the npm package name
  // ("@openclaw/whatsapp") -- the package name is silently treated as "not found" and the
  // real plugin ends up omitted from the allowlist.
  //
  // document-extract, duckduckgo and web-readability are BUNDLED in the base image
  // (/app/dist/extensions) rather than installed by this repo's Dockerfile -- but bundled is
  // not enabled: a non-empty `allow` is a hard gate that bundled plugins do not bypass, even
  // ones whose manifest sets `enabledByDefault: true`. They load only because they are listed
  // here. brave and searxng are npm installs baked in by the image.
  // Deliberately absent despite being available in the image:
  //   diffs      - its useful mode (mode=file, rendering a diff to PNG/PDF for delivery over a
  //                chat channel) needs Chromium, which the -slim base image strips along with
  //                Puppeteer. That leaves only mode=view, a gateway-hosted HTML viewer whose
  //                links default to loopback and need `security.allowRemoteViewer` (default
  //                false) plus a `viewerBaseUrl` before they resolve anywhere useful --
  //                i.e. exposing tokenised viewer URLs through the ingress for a convenience
  //                plugin. Revisit if the image ever moves off -slim.
  //   xai        - its only unique capability is x_search over X posts. Needs XAI_API_KEY and
  //                direct egress to api.x.ai, the one model-vendor path that would bypass
  //                LiteLLM and its spend tracking, and xAI bills X Search per call ($5/1000)
  //                with no per-day cap available in plugin config. Not worth it for now.
  //   voice-call - baked in for a future outbound-alerting path, not wired yet. See tools.deny;
  //                code_execution is likewise pre-denied on xai's behalf.
  "plugins": {
    "allow": [
      "brave",
      "diagnostics-prometheus",
      "document-extract",
      "duckduckgo",
      "litellm",
      "lobster",
      "memory-core",
      "memory-lancedb",
      "searxng",
      "telegram",
      "web-readability",
      "whatsapp"
    ],
    "slots": {
      "memory": "memory-lancedb"
    },
    "entries": {
      // The active web-search provider (tools.web.search.provider above). BRAVE_API_KEY comes
      // from the openclaw-plugin-secrets ExternalSecret, pulled into the container wholesale
      // via the envFrom patch in kustomizations/apps-ai.yaml and expanded here by OpenClaw at
      // startup. searxng is allowlisted below but unconfigured -- it needs an in-cluster
      // instance before it can take over.
      "brave": {
        "enabled": true,
        "config": {
          "webSearch": {
            "apiKey": "${BRAVE_API_KEY}"
          }
        }
      },
      "diagnostics-prometheus": {
        "enabled": true
      },
      // Parses untrusted PDFs/attachments in-process via clawpdf. Acceptable only because
      // WhatsApp DMs and groups are allowlisted to the operator's own numbers
      // (channels.whatsapp), so the set of senders who can reach the parser is just the
      // operator. Revisit if channels.whatsapp.allowFrom or groupAllowFrom is ever widened.
      "document-extract": {
        "enabled": true
      },
      "duckduckgo": {
        "enabled": true
      },
      "litellm": {
        "enabled": true
      },
      "lobster": {
        "enabled": true
      },
      // autoRecall and autoCapture run through typed hooks that read conversation content.
      // memory-lancedb is an npm install, not bundled, so the gateway blocks those hooks
      // unless the grant below is set. The plugin still loads without it and both features
      // silently do nothing.
      "memory-lancedb": {
        "enabled": true,
        "hooks": {
          "allowConversationAccess": true
        },
        "config": {
          "autoCapture": true,
          "autoRecall": true,
          "dreaming": {
            "enabled": true
          },
          "embedding": {
            "provider": "openai",
            "model": "text-embedding-3-small",
            "baseUrl": "http://litellm.ai.svc.cluster.local:4000/v1"
          }
        }
      },
      "searxng": {
        "enabled": true
      },
      "telegram": {
        "enabled": true
      },
      // Extracts readable article text from web_fetch HTML responses via @mozilla/readability
      // + linkedom (pure JS, no native code). Net reduction in prompt-injection surface: the
      // model sees article text instead of raw HTML with nav, ads and inline script.
      "web-readability": {
        "enabled": true
      },
      "whatsapp": {
        "enabled": true
      }
    }
    // No `bundledDiscovery` key: it lives in the gateway's SQLite state (config_machine_state
    // row `plugins.bundledDiscovery`), which must read "allowlist" for `allow` above to gate
    // bundled plugins. Any `openclaw doctor` run, even without --fix, stores "compat" there when
    // the row is missing, because this file has no meta.lastTouchedVersion. "compat" enables
    // dozens of bundled provider plugins outside `allow`, and no CLI sets the row back, so check
    // it after a doctor run. Once the row exists, doctor keeps its value. --fix also rewrites
    // this file, replacing ${...} references with literals.
  },

  "skills": {
    "workshop": {
      "autonomous": {
        "mode": "off"
      }
    },
    "entries": {
      "1password": {
        "enabled": false
      },
      "apple-notes": {
        "enabled": false
      },
      "apple-reminders": {
        "enabled": false
      },
      "bear-notes": {
        "enabled": false
      },
      "blogwatcher": {
        "enabled": false
      },
      "blucli": {
        "enabled": false
      },
      "camsnap": {
        "enabled": false
      },
      "clawhub": {
        "enabled": false
      },
      "coding-agent": {
        "enabled": false
      },
      "eightctl": {
        "enabled": false
      },
      "gemini": {
        "enabled": false
      },
      "gifgrep": {
        "enabled": false
      },
      "gog": {
        "enabled": false
      },
      "goplaces": {
        "enabled": false
      },
      "himalaya": {
        "enabled": false
      },
      "mcporter": {
        "enabled": false
      },
      "model-usage": {
        "enabled": false
      },
      "nano-pdf": {
        "enabled": false
      },
      "notion": {
        "enabled": false
      },
      "obsidian": {
        "enabled": false
      },
      "openai-whisper": {
        "enabled": false
      },
      "openai-whisper-api": {
        "enabled": false
      },
      "openhue": {
        "enabled": false
      },
      "ordercli": {
