// Cluster-owned log collection jobs for three apps that write their logs into a
// CSI-mounted PVC instead of stdout. They are read on the node, through the pod's
// own kubelet directory, so they are invisible to the module's /var/log/pods job.
//
// Read before editing:
//
//   - This file is the source of truth, but it is not what Flux applies. A Flux
//     Kustomization's spec.patches are inline-only, so a verbatim copy of this file
//     is embedded in clusters/homelab/kustomizations/infra-observability-core.yaml,
//     which is how it reaches the module's alloy-config ConfigMap and thereby
//     /etc/alloy. `ci/scripts/alloy-lint.sh check-embedded` fails if the two drift.
//   - Every *.alloy file in /etc/alloy shares one component namespace, so
//     cluster-supplied components must carry the `cluster_` prefix the module
//     requires. A duplicate name fails the whole config load, not just this file --
//     and it fails asymmetrically: a running collector rejects a bad reload with a
//     400 and keeps its last valid config, while a fresh pod exits. A broken
//     fragment therefore stays invisible until the DaemonSet next rolls, then takes
//     out log collection node by node.
//   - These streams deliberately carry no `job` label, unlike the module's pod-log
//     job. That is inherited from the promtail jobs they replace; adding one would
//     change the identity of series that already exist in Loki.
//   - `file_match` is required on every loki.source.file here: without it
//     loki.source.file os.Stat()s __path__ literally and a glob matches nothing,
//     with no error and no unhealthy component.

// ----------------------------------------------------------------------------------
// pihole -- *.log at the root of its CSI volume
// ----------------------------------------------------------------------------------

discovery.relabel "cluster_pihole_pvc_logs" {
	targets = discovery.kubernetes.pods.targets

	rule {
		action        = "keep"
		source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
		regex         = "pihole"
	}

	rule {
		action        = "keep"
		source_labels = ["__meta_kubernetes_pod_container_name"]
		regex         = "pihole"
	}

	rule {
		action        = "replace"
		source_labels = ["__meta_kubernetes_pod_uid"]
		replacement   = "/var/lib/kubelet/pods/$1/volumes/kubernetes.io~csi/*/mount/*.log"
		target_label  = "__path__"
	}

	rule {
		action        = "replace"
		source_labels = [
			"__meta_kubernetes_pod_label_app_kubernetes_io_name",
			"__meta_kubernetes_pod_label_app",
		]
		regex        = "^;*([^;]+)(;.*)?$"
		target_label = "app"
	}

	rule {
		action        = "replace"
		source_labels = [
			"__meta_kubernetes_pod_label_app_kubernetes_io_instance",
			"__meta_kubernetes_pod_label_instance",
		]
		regex        = "^;*([^;]+)(;.*)?$"
		target_label = "instance"
	}

	rule {
		action        = "replace"
		source_labels = [
			"__meta_kubernetes_pod_label_app_kubernetes_io_component",
			"__meta_kubernetes_pod_label_component",
		]
		regex        = "^;*([^;]+)(;.*)?$"
		target_label = "component"
	}

	rule {
		action        = "replace"
		source_labels = ["__meta_kubernetes_pod_node_name"]
		target_label  = "node_name"
	}

	rule {
		action        = "replace"
		source_labels = ["__meta_kubernetes_namespace"]
		target_label  = "namespace"
	}

	rule {
		action        = "replace"
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "pod"
	}

	rule {
		action        = "replace"
		source_labels = ["__meta_kubernetes_pod_container_name"]
		target_label  = "container"
	}
}

loki.source.file "cluster_pihole_pvc_logs" {
	targets    = discovery.relabel.cluster_pihole_pvc_logs.output
	forward_to = [loki.process.cluster_pihole_pvc_logs.receiver]

	file_match {
		enabled = true
	}
}

loki.process "cluster_pihole_pvc_logs" {
	forward_to = [loki.write.default.receiver]

	// Reduce the filename label to the path within the volume; the kubelet prefix is
	// per-pod and would make every stream unique across restarts.
	stage.regex {
		source     = "filename"
		expression = ".*/kubernetes.io~csi/[^/]+/mount/(?P<clean_filename>.*)"
	}

	stage.labels {
		values = {
			filename = "clean_filename",
		}
	}
}

// ----------------------------------------------------------------------------------
// plex -- *.log at the CSI volume root, or one level down in a named subdirectory
// ----------------------------------------------------------------------------------

discovery.relabel "cluster_plex_pvc_logs" {
	targets = discovery.kubernetes.pods.targets

	rule {
		action        = "keep"
		source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
		regex         = "plex"
	}

	rule {
		action        = "keep"
		source_labels = ["__meta_kubernetes_pod_container_name"]
		regex         = "plex"
	}

	// The middle `*` matches the pod's CSI volume by PersistentVolume name, which this
	// job deliberately does not pin -- plex-logs is dynamically provisioned, so its PV
	// name is generated and would change (silently stopping collection) if the volume
	// were ever recreated.
	//
	// Do not widen `{*,*/*}` back to `**`: this pod also mounts its 32Gi config volume
	// and the entire read-only media library through the same kubernetes.io~csi/
	// prefix, and `**` recursively re-walks all three on every file_match sync_period,
	// not just plex-logs -- that walk measured ~740m CPU sustained on the node this pod
	// lands on (vs 17-52m for the DaemonSet's other pods), from a glob that did less
	// useful work than its peers while doing it. `{*,*/*}` is a doublestar alternation
	// bounded to the two depths plex actually writes logs at: the volume root, and one
	// named subdirectory (`PMS Plugin Logs/`). It deliberately excludes the crash
	// report file several levels deep in the *config* volume (Library/Application
	// Support/Plex Media Server/Crash Reports/...): that's a diagnostic dump from the
	// wrong volume, not a log this job is meant to collect, and reaching it would mean
	// either pinning the config volume's PV name or re-adding the expensive recursive
	// walk this change removes.
	rule {
		action        = "replace"
		source_labels = ["__meta_kubernetes_pod_uid"]
		replacement   = "/var/lib/kubelet/pods/$1/volumes/kubernetes.io~csi/*/mount/{*,*/*}.log"
		target_label  = "__path__"
	}

	rule {
		action        = "replace"
		source_labels = [
			"__meta_kubernetes_pod_label_app_kubernetes_io_name",
			"__meta_kubernetes_pod_label_app",
		]
		regex        = "^;*([^;]+)(;.*)?$"
		target_label = "app"
	}

	rule {
		action        = "replace"
		source_labels = [
			"__meta_kubernetes_pod_label_app_kubernetes_io_instance",
			"__meta_kubernetes_pod_label_instance",
		]
		regex        = "^;*([^;]+)(;.*)?$"
		target_label = "instance"
	}

	rule {
		action        = "replace"
		source_labels = [
			"__meta_kubernetes_pod_label_app_kubernetes_io_component",
			"__meta_kubernetes_pod_label_component",
		]
		regex        = "^;*([^;]+)(;.*)?$"
		target_label = "component"
	}

	rule {
		action        = "replace"
		source_labels = ["__meta_kubernetes_pod_node_name"]
		target_label  = "node_name"
	}

	rule {
		action        = "replace"
		source_labels = ["__meta_kubernetes_namespace"]
		target_label  = "namespace"
	}

	rule {
		action        = "replace"
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "pod"
	}

	rule {
		action        = "replace"
		source_labels = ["__meta_kubernetes_pod_container_name"]
		target_label  = "container"
	}
}

loki.source.file "cluster_plex_pvc_logs" {
	targets    = discovery.relabel.cluster_plex_pvc_logs.output
	forward_to = [loki.process.cluster_plex_pvc_logs.receiver]

	// Defence-in-depth alongside the bounded glob above: these are tailed files, not a
	// once-per-period scrape, so a slower re-glob only delays *new* files/pods showing
	// up, by up to a minute -- not a problem for logs nothing alerts on. A future glob
	// mistake here (or a fourth volume added to the pod) re-walks less often.
	file_match {
		enabled     = true
		sync_period = "1m"
	}
}

loki.process "cluster_plex_pvc_logs" {
	forward_to = [loki.write.default.receiver]

	stage.regex {
		source     = "filename"
		expression = ".*/kubernetes.io~csi/[^/]+/mount/(?P<clean_filename>.*)"
	}

	stage.labels {
		values = {
			filename = "clean_filename",
		}
	}
}

// ----------------------------------------------------------------------------------
// traefik -- one access.log per pod on a shared RWX volume, so the pod name is part
// of the path and every pod's collector would otherwise see all of them
// ----------------------------------------------------------------------------------

discovery.relabel "cluster_traefik_access_rwx_logs" {
	targets = discovery.kubernetes.pods.targets

	rule {
		action        = "keep"
		source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
		regex         = "traefik"
	}

	// Excludes the log-rotate sidecar, which shares the volume.
	rule {
		action        = "keep"
		source_labels = ["__meta_kubernetes_pod_container_name"]
		regex         = "traefik"
	}

	rule {
		action        = "replace"
		source_labels = ["__meta_kubernetes_pod_uid", "__meta_kubernetes_pod_name"]
		separator     = ";"
		regex         = "(.+);(.+)"
		replacement   = "/var/lib/kubelet/pods/$1/volumes/kubernetes.io~csi/*/mount/$2/access.log"
		target_label  = "__path__"
	}

	rule {
		action        = "replace"
		source_labels = [
			"__meta_kubernetes_pod_label_app_kubernetes_io_name",
			"__meta_kubernetes_pod_label_app",
		]
		regex        = "^;*([^;]+)(;.*)?$"
		target_label = "app"
	}

	rule {
		action        = "replace"
		source_labels = [
			"__meta_kubernetes_pod_label_app_kubernetes_io_instance",
			"__meta_kubernetes_pod_label_instance",
		]
		regex        = "^;*([^;]+)(;.*)?$"
		target_label = "instance"
	}

	rule {
		action        = "replace"
		source_labels = [
			"__meta_kubernetes_pod_label_app_kubernetes_io_component",
			"__meta_kubernetes_pod_label_component",
		]
		regex        = "^;*([^;]+)(;.*)?$"
		target_label = "component"
	}

	rule {
		action        = "replace"
		source_labels = ["__meta_kubernetes_pod_node_name"]
		target_label  = "node_name"
	}

	rule {
		action        = "replace"
		source_labels = ["__meta_kubernetes_namespace"]
		target_label  = "namespace"
	}

	rule {
		action        = "replace"
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "pod"
	}

	rule {
		action        = "replace"
		source_labels = ["__meta_kubernetes_pod_container_name"]
		target_label  = "container"
	}
}

loki.source.file "cluster_traefik_access_rwx_logs" {
	targets    = discovery.relabel.cluster_traefik_access_rwx_logs.output
	forward_to = [loki.process.cluster_traefik_access_rwx_logs.receiver]

	file_match {
		enabled = true
	}
}

loki.process "cluster_traefik_access_rwx_logs" {
	forward_to = [loki.write.default.receiver]

	// drop_malformed discards the rotation marker lines the log-rotate sidecar
	// writes, which are not JSON.
	stage.json {
		expressions = {
			timestamp = "time",
			status    = "DownstreamStatus",
			method    = "RequestMethod",
		}
		drop_malformed = true
	}

	// One directory deeper than the other two jobs: the pod name sits between the
	// volume root and the file.
	stage.regex {
		source     = "filename"
		expression = ".*/kubernetes.io~csi/[^/]+/mount/.*/(?P<clean_filename>.*)"
	}

	stage.labels {
		values = {
			status   = "status",
			method   = "method",
			filename = "clean_filename",
		}
	}

	stage.timestamp {
		source = "timestamp"
		format = "RFC3339"
	}
}
