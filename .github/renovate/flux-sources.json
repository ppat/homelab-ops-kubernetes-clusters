{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "addLabels": [
        "automerge:off",
        "cluster:{{ lookup (split packageFileDir '/') 1 }}",
        "dependency-type:flux-source"
      ],
      "automerge": false,
      "commitMessageAction": "deploy",
      "description": [
        "Source repos tag either per-module (`<module>-vX.Y.Z`, one repo releasing many modules independently) or whole-repo (`vX.Y.Z`); the module prefix is optional here so both shapes reduce to a bare semver.",
        "The compatibility capture is load-bearing, not cosmetic: a tag lookup returns every tag in the repo, and Renovate keeps only those releases whose compatibility group equals the pinned one — that is what stops one module's source being offered another module's tags. A tag shape this regex fails to match yields zero candidate releases, so the source silently stops being bumped rather than erroring."
      ],
      "groupName": "{{ lookup (split packageFileDir '/') 1 }}-{{newValue}}",
      "matchDatasources": [
        "github-releases",
        "github-tags",
        "git-tags"
      ],
      "matchManagers": [
        "flux"
      ],
      "matchFileNames": [
        "clusters/homelab/sources/**.yaml",
        "clusters/nas/sources/**.yaml"
      ],
      "minimumReleaseAge": "",
      "semanticCommitType": "chore",
      "semanticCommitScope": "cluster-{{ lookup (split packageFileDir '/') 1 }}",
      "versionCompatibility": "^(?:(?<compatibility>.+)-)?(?<version>v?\\d+\\.\\d+\\.\\d+.*)$",
      "versioning": "semver"
    },
    {
      "addLabels": [
        "automerge:off",
        "cluster:{{ lookup (split packageFileDir '/') 1 }}",
        "dependency-type:kustomize-remote-resource"
      ],
      "automerge": false,
      "commitMessageAction": "deploy",
      "commitMessageTopic": "{{newValue}}",
      "description": [
        "Remote kustomize bases are pinned to the same repos as the Flux sources above and carry the same tag shapes, so the version handling is identical."
      ],
      "groupName": "{{ lookup (split packageFileDir '/') 1 }}-{{newValue}}",
      "matchDatasources": [
        "github-tags",
        "git-tags"
      ],
      "matchManagers": [
        "kustomize"
      ],
      "matchFileNames": [
        "clusters/**/kustomization.yaml"
      ],
      "minimumReleaseAge": "",
      "semanticCommitType": "chore",
      "semanticCommitScope": "cluster-{{ lookup (split packageFileDir '/') 1 }}",
      "versionCompatibility": "^(?:(?<compatibility>.+)-)?(?<version>v?\\d+\\.\\d+\\.\\d+.*)$",
      "versioning": "semver"
    }
  ]
}
